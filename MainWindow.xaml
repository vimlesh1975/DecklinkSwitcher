<Window x:Class="DecklinkSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DecklinkSwitcher"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="600"
        Title="DeckLink Switcher" Height="780" Width="1280" Background="{DynamicResource WindowBg}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
    
    <Window.Resources>
        <DataTemplate x:Key="InputTileTemplate">
            <Border Style="{DynamicResource MixerPanel}">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioL, Mode=OneWay}" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                        <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Height="100" Width="158" Cursor="Hand">
                                <Image.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectInputCmd}" />
                                </Image.InputBindings>
                            </Image>
                        </Border>
                        <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioR, Mode=OneWay}" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                        <Slider Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="{Binding AudioLevel, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1"/>
                    </StackPanel>
                    <Button Content="{Binding DisplayName}" Command="{Binding SelectInputCmd}" FontSize="14" FontWeight="SemiBold" Height="36" Background="{Binding BgColor}" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"/>
                    <ComboBox FontSize="12" Height="26" Margin="0,8,0,0" SelectedIndex="{Binding AudioStateIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="AFV"/>
                        <ComboBoxItem Content="ON"/>
                        <ComboBoxItem Content="OFF"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScreenTileTemplate">
            <Border Style="{DynamicResource MixerPanel}">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Height="100" Width="158" Cursor="Hand">
                                <Image.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectInputCmd}" />
                                </Image.InputBindings>
                            </Image>
                        </Border>
                    </StackPanel>
                    <Button Content="{Binding DisplayName}" Command="{Binding SelectInputCmd}" FontSize="14" FontWeight="SemiBold" Height="36" Background="{Binding BgColor}" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WebcamTileTemplate">
            <Border Style="{DynamicResource MixerPanel}">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioL, Mode=OneWay}" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                        <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Height="100" Width="158" Cursor="Hand">
                                <Image.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectInputCmd}" />
                                </Image.InputBindings>
                            </Image>
                        </Border>
                        <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioR, Mode=OneWay}" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                        <Slider Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="{Binding AudioLevel, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1"/>
                    </StackPanel>
                    <Button Content="{Binding DisplayName}" ToolTip="{Binding DeviceName}" Command="{Binding SelectInputCmd}" FontSize="14" FontWeight="SemiBold" Height="36" Background="{Binding BgColor}" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"/>
                    <ComboBox FontSize="12" Height="26" Margin="0,8,0,0" SelectedIndex="{Binding AudioStateIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="AFV"/>
                        <ComboBoxItem Content="ON"/>
                        <ComboBoxItem Content="OFF"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00e676"/>
                                <Setter TargetName="BtnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00e676" BlurRadius="20" ShadowDepth="0" Opacity="1.0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#00e676"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#ffffff"/>
                                <Setter TargetName="BtnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00e676" BlurRadius="30" ShadowDepth="0" Opacity="1.0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="MixerPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource PanelBgColor}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource PanelBgDarkColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="Black"/> <!-- Default text in standard combo box often requires black unless fully restyled -->
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Name="TemplateRoot"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="1" 
                                SnapsToDevicePixels="True">
                            <Grid Name="PART_Track">
                                <!-- Dim unlit zones -->
                                <Border Name="DimTrack" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0.18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00e676" Offset="0.0"/>
                                            <GradientStop Color="#00e676" Offset="0.65"/>
                                            <GradientStop Color="#ffd600" Offset="0.68"/>
                                            <GradientStop Color="#ffd600" Offset="0.82"/>
                                            <GradientStop Color="#ff1744" Offset="0.85"/>
                                            <GradientStop Color="#ff1744" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Active illuminated indicator -->
                                <Border Name="PART_Indicator" 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Stretch" 
                                        ClipToBounds="True">
                                    <Border Name="LitBar" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Stretch" 
                                            Width="{Binding ActualWidth, ElementName=PART_Track}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00e676" Offset="0.0"/>
                                                <GradientStop Color="#00e676" Offset="0.65"/>
                                                <GradientStop Color="#ffd600" Offset="0.68"/>
                                                <GradientStop Color="#ffd600" Offset="0.82"/>
                                                <GradientStop Color="#ff1744" Offset="0.85"/>
                                                <GradientStop Color="#ff1744" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="TemplateRoot" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,25,0">
            <TextBlock Text="CPU:" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock Name="TxtCpuUsage" Text="0%" Foreground="#00e676" FontSize="12" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center" Width="40"/>
            
            <TextBlock Text="Dark Mode" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <CheckBox Name="ChkDarkMode" IsChecked="True" VerticalAlignment="Center" Checked="ChkDarkMode_Checked" Unchecked="ChkDarkMode_Unchecked" Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT COLUMN: Previews and Switcher -->
        <Grid Grid.Column="0" Name="LeftPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Output Preview -->
                <RowDefinition Height="*"/> <!-- Inputs -->
            </Grid.RowDefinitions>
            
            <!-- Output Preview -->
            <Border Grid.Row="0" Style="{StaticResource MixerPanel}" Margin="0,0,0,25">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="PROGRAM OUTPUT" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ProgressBar Name="AudioOutputL" Orientation="Vertical" Minimum="0" Maximum="100" Width="12" Height="270" Margin="0,0,15,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                        <StackPanel Orientation="Vertical">
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource ImageBg}" Padding="2">
                                <Grid Width="480" Height="270" ClipToBounds="True">
                                    <Image Name="PreviewOutput" Stretch="Uniform" Height="270" Width="480"/>
                                    <Canvas Width="480" Height="270" IsHitTestVisible="False" ClipToBounds="True">
                                        <Image Name="PreviewLogoOverlay" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <CheckBox Name="ChkSystemAudioOut" Content="System Audio Out (Monitor)" Foreground="{DynamicResource TextDim}" Margin="0,0,18,0" VerticalAlignment="Center" Checked="ChkSystemAudioOut_Checked" Unchecked="ChkSystemAudioOut_Unchecked"/>
                                <CheckBox Name="ChkLogoOverlay" Content="PGM Logo Overlay" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Checked="ChkLogoOverlay_Changed" Unchecked="ChkLogoOverlay_Changed"/>
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Name="AudioOutputR" Orientation="Vertical" Minimum="0" Maximum="100" Width="12" Height="270" Margin="15,0,0,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                        
                        <StackPanel Orientation="Vertical" Margin="25,0,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="VOL" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Slider Name="SldPgmAudio" Orientation="Vertical" Height="250" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldPgmAudio_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SWITCHER SCROLL VIEWER -->
            <ScrollViewer Grid.Row="1" Name="SwitcherScrollViewer" AllowDrop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly" CanContentScroll="False">
                <WrapPanel Name="SwitcherPanel" IsEnabled="False" Orientation="Horizontal" HorizontalAlignment="Center" AllowDrop="True">


            <!-- Special Sources -->
                <Border Name="TileMedia" Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ProgressBar Name="AudioBarMediaL" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                                <Image Name="PreviewMedia" Stretch="Uniform" Height="100" Width="158" MouseDown="PreviewMedia_MouseDown" Cursor="Hand"/>
                            </Border>
                            <ProgressBar Name="AudioBarMediaR" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Slider Name="SldMediaAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldMediaAudio_ValueChanged"/>
                        </StackPanel>
                        <Button Name="BtnMedia" Content="Local Video" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnMedia_Click" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Cursor="Hand"/>
                        <!-- Media Control Buttons -->
                        <Grid Margin="0,0,0,6" Width="184">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Name="BtnSelectMedia" Grid.Column="0" Content="Select File" FontSize="11" FontWeight="SemiBold" Height="26" Click="BtnSelectMedia_Click" Background="{DynamicResource ButtonAltBg}" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"/>
                            <Button Name="BtnStopMedia" Grid.Column="2" Content="Stop" FontSize="11" FontWeight="Bold" Height="26" Width="60" Click="BtnStopMedia_Click" Background="#c62828" Foreground="White" Cursor="Hand"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Name="BtnCueMedia" Content="Cue" FontSize="11" Height="24" Width="45" Click="BtnCueMedia_Click" Background="{DynamicResource ButtonAltBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,4,0" Cursor="Hand"/>
                            <Button Name="BtnPauseMedia" Content="Pause" FontSize="11" Height="24" Width="55" Click="BtnPauseMedia_Click" Background="{DynamicResource ButtonAltBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,4,0" Cursor="Hand"/>
                            <Button Name="BtnResumeMedia" Content="Resume" FontSize="11" FontWeight="SemiBold" Height="24" Width="65" Click="BtnResumeMedia_Click" Background="#2e7d32" Foreground="White" Cursor="Hand"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <CheckBox Name="ChkLoopMedia" Content="Loop" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" Margin="0,0,10,0"/>
                            <Slider Name="SldMediaSeek" Width="140" Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.01" 
                                    Thumb.DragStarted="SldMediaSeek_DragStarted" Thumb.DragCompleted="SldMediaSeek_DragCompleted" ValueChanged="SldMediaSeek_ValueChanged"/>
                        </StackPanel>
                        <ComboBox Name="CmbAudioStateMedia" FontSize="12" Height="26" SelectionChanged="CmbAudioState_SelectionChanged">
                            <ComboBoxItem Content="AFV"/>
                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Name="TileYouTube" Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ProgressBar Name="AudioBarYTL" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                                <Grid Width="158" Height="100">
                                    <Image Name="PreviewYouTube" Stretch="Uniform" MouseDown="PreviewYouTube_MouseDown" Cursor="Hand"/>
                                    <StackPanel Name="PnlYouTubeStatusOverlay" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Name="TxtYouTubeStatusIcon" Text="▶" FontSize="20" HorizontalAlignment="Center" Foreground="#ff3333" Margin="0,0,0,2"/>
                                        <TextBlock Name="TxtYouTubeStatus" Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ProgressBar Name="AudioBarYTR" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Slider Name="SldYouTubeAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldYouTubeAudio_ValueChanged"/>
                        </StackPanel>
                        <Button Name="BtnYouTube" Content="YouTube Live" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnYouTube_Click" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Cursor="Hand"/>
                        <Expander Name="ExpanderYouTubeUrl" Header="Stream URL / Live" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8" IsExpanded="True" MaxWidth="200">
                            <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                <TextBox Name="TxtYouTubeUrl" Height="24" FontSize="11" Margin="0,0,0,6" 
                                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" 
                                         BorderBrush="{DynamicResource ControlBorder}" ToolTip="YouTube Live URL (e.g. https://www.youtube.com/watch?v=...)"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Button Name="BtnConnectYouTube" Content="Connect" FontSize="11" FontWeight="Bold" Height="26" Width="80" Click="BtnConnectYouTube_Click" Background="#2e7d32" Foreground="White" Margin="0,0,6,0" Cursor="Hand"/>
                                    <Button Name="BtnDisconnectYouTube" Content="Stop" FontSize="11" FontWeight="Bold" Height="26" Width="65" Click="BtnDisconnectYouTube_Click" Background="#c62828" Foreground="White" IsEnabled="False" Cursor="Hand"/>
                                </StackPanel>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sync:" FontSize="10" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider Name="SldYouTubeAudioDelay" Grid.Column="1" Minimum="0" Maximum="1000" Value="200" SmallChange="10" LargeChange="50" TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="SldYouTubeAudioDelay_ValueChanged"/>
                                    <TextBlock Name="TxtYouTubeAudioDelay" Grid.Column="2" Text="200ms" FontSize="10" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <ComboBox Name="CmbAudioStateYouTube" FontSize="12" Height="26" SelectionChanged="CmbAudioState_SelectionChanged">
                            <ComboBoxItem Content="AFV"/>
                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Name="TileColorBars" Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ProgressBar Name="AudioBarCBL" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                                <Image Name="PreviewColorBars" Stretch="Uniform" Height="100" Width="158" MouseDown="PreviewColorBars_MouseDown" Cursor="Hand"/>
                            </Border>
                            <ProgressBar Name="AudioBarCBR" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Slider Name="SldColorBarsAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldColorBarsAudio_ValueChanged"/>
                        </StackPanel>
                        <Button Name="BtnColorBars" Content="Color Bars" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnColorBars_Click" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"/>
                        <ComboBox Name="CmbAudioStateColorBars" FontSize="12" Height="26" Margin="0,8,0,0" SelectionChanged="CmbAudioState_SelectionChanged">
                            <ComboBoxItem Content="AFV"/>
                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                
                <Border Name="TileMatte" Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}">
                                <Image Name="PreviewMatte" Stretch="Uniform" Height="100" Width="158" MouseDown="PreviewMatte_MouseDown" Cursor="Hand"/>
                            </Border>
                        </StackPanel>
                        <Button Name="BtnMatte" Content="Matte Color" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnMatte_Click" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Cursor="Hand"/>
                        <ComboBox Name="CmbMatteColor" FontSize="12" Height="26" SelectedIndex="4" SelectionChanged="CmbMatteColor_SelectionChanged">
                            <ComboBoxItem Content="Black"/>
                            <ComboBoxItem Content="White"/>
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Yellow"/>
                            <ComboBoxItem Content="Cyan"/>
                            <ComboBoxItem Content="Magenta"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Name="TileSystemAudio" Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ProgressBar Name="AudioBarSysL" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource ImageBg}" Width="158" Height="100">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                    <TextBlock Text="🔊" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock Text="Loopback Capture" FontSize="10" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSystemAudioDevice" Width="144" Height="24" FontSize="10" DisplayMemberPath="Name" SelectionChanged="CmbSystemAudioDevice_SelectionChanged"/>
                                </StackPanel>
                            </Border>
                            <ProgressBar Name="AudioBarSysR" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="{DynamicResource PanelBg}"/>
                            <Slider Name="SldSystemAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldSystemAudio_ValueChanged"/>
                        </StackPanel>
                        <Button Name="BtnSystemAudio" Content="System Audio" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnSystemAudio_Click" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Cursor="Hand"/>
                        <ComboBox Name="CmbAudioStateSystemAudio" FontSize="12" Height="26" SelectionChanged="CmbAudioStateSystemAudio_SelectionChanged">
                            <ComboBoxItem Content="AFV"/>
                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

            </WrapPanel>
            </ScrollViewer>
        </Grid>

        <!-- SETTINGS PANEL -->
        <Border Grid.Column="1" Style="{StaticResource MixerPanel}" Margin="25,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="SETTINGS" FontSize="16" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20" FontWeight="Black"/>
                    
                    <TextBlock Text="Output Device:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox Name="CmbOutput" Height="28" Margin="0,0,0,20" DisplayMemberPath="DisplayName"/>
                    
                    <ItemsControl Name="InputSelectorsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableDevices}" 
                                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" 
                                              DisplayMemberPath="DisplayName" Height="28"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Format:" Foreground="{DynamicResource TextDim}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFormats}" 
                                                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" 
                                                  Height="24" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <Button Name="BtnApplySettings" Content="Apply Settings &amp; Start" Height="36" Background="#0066cc" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Click="BtnApplySettings_Click" Cursor="Hand" Margin="0,10,0,0"/>
                    
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,15"/>
                    
                    <TextBlock Text="PGM LOGO OVERLAY" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" FontWeight="Black"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="85"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="BtnSelectLogo" Grid.Column="0" Content="Select Logo..." Height="30" FontSize="11" FontWeight="SemiBold" Background="{DynamicResource ButtonAltBg}" Foreground="{DynamicResource TextPrimary}" Click="BtnSelectLogo_Click" Cursor="Hand"/>
                        <Button Name="BtnToggleLogo" Grid.Column="2" Content="LOGO: OFF" Height="30" FontSize="11" FontWeight="Bold" Background="#424242" Foreground="White" Click="BtnToggleLogo_Click" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Name="TxtLogoFileName" Text="No logo selected" FontSize="10" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                    <TextBlock Text="Position Preset:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox Name="CmbLogoPosition" Height="26" FontSize="11" Margin="0,0,0,8" SelectionChanged="CmbLogoPosition_SelectionChanged">
                        <ComboBoxItem Content="Top-Right" IsSelected="True"/>
                        <ComboBoxItem Content="Top-Left"/>
                        <ComboBoxItem Content="Bottom-Right"/>
                        <ComboBoxItem Content="Bottom-Left"/>
                        <ComboBoxItem Content="Center"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size:" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                        <Slider Name="SldLogoSize" Grid.Column="1" Minimum="3" Maximum="50" Value="15" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="SldLogoSize_ValueChanged"/>
                        <TextBlock Name="TxtLogoSizeVal" Grid.Column="2" Text="15%" FontSize="10" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity:" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                        <Slider Name="SldLogoOpacity" Grid.Column="1" Minimum="10" Maximum="100" Value="100" SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="SldLogoOpacity_ValueChanged"/>
                        <TextBlock Name="TxtLogoOpacityVal" Grid.Column="2" Text="100%" FontSize="10" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pos X:" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                        <Slider Name="SldLogoX" Grid.Column="1" Minimum="0" Maximum="100" Value="96" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="SldLogoPos_ValueChanged"/>
                        <TextBlock Name="TxtLogoXVal" Grid.Column="2" Text="96%" FontSize="10" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pos Y:" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                        <Slider Name="SldLogoY" Grid.Column="1" Minimum="0" Maximum="100" Value="4" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="SldLogoPos_ValueChanged"/>
                        <TextBlock Name="TxtLogoYVal" Grid.Column="2" Text="4%" FontSize="10" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,16,0,15"/>
                    
                    <TextBlock Text="YOUTUBE STREAMING" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" FontWeight="Black"/>
                    <TextBlock Text="Stream Key:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtStreamKey" Margin="0,0,0,12" Height="28" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2"/>
                    <Button Name="BtnStream" Content="START STREAM" Height="40" Background="#d32f2f" Foreground="{DynamicResource TextPrimary}" Click="BtnStream_Click" FontWeight="Black" Cursor="Hand"/>
                    
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,15"/>
                    
                    <TextBlock Text="RECORDING PROFILES" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" FontWeight="Black"/>
                    <TextBlock Text="Profile:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox Name="CmbRecordingProfile" Height="28" Margin="0,0,0,12" DisplayMemberPath="DisplayName"/>
                    
                    <TextBlock Text="Recording Directory:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TxtRecordingDirectory" Height="28" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2"/>
                        <Button Name="BtnBrowseRecordingDir" Grid.Column="1" Content="..." Width="30" Height="28" Margin="5,0,0,0" Background="#333333" Foreground="{DynamicResource TextPrimary}" Click="BtnBrowseRecordingDir_Click" Cursor="Hand"/>
                    </Grid>
                    
                    <Button Name="BtnRecord" Content="START RECORDING" Height="40" Background="#d32f2f" Foreground="{DynamicResource TextPrimary}" Click="BtnRecord_Click" FontWeight="Black" Cursor="Hand"/>
                    
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,15"/>
                    
                    <TextBlock Text="NDI OUTPUT" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" FontWeight="Black"/>
                    <TextBlock Text="Stream Name:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtNdiName" Text="DeckLink Switcher - Program" Height="28" Margin="0,0,0,12" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2"/>
                    <Button Name="BtnNdi" Content="START NDI" Height="40" Background="#0066cc" Foreground="{DynamicResource TextPrimary}" Click="BtnNdi_Click" FontWeight="Black" Cursor="Hand"/>
                    
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,15"/>
                    
                    <TextBlock Text="SRT OUTPUT" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" FontWeight="Black"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="Mode:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Name="CmbSrtMode" Height="28" SelectionChanged="CmbSrtMode_SelectionChanged">
                                <ComboBoxItem Content="Caller" IsSelected="True"/>
                                <ComboBoxItem Content="Listener"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Port:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Name="TxtSrtPort" Text="9000" Height="28" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2" TextChanged="SrtInput_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Name="LblSrtHost" Text="Host / IP (Caller Mode):" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtSrtHost" Text="127.0.0.1" Height="28" Margin="0,0,0,8" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2" TextChanged="SrtInput_TextChanged"/>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="Latency (ms):" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Name="TxtSrtLatency" Text="200" Height="28" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2" TextChanged="SrtInput_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Stream ID (Optional):" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Name="TxtSrtStreamId" Height="28" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2" TextChanged="SrtInput_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Passphrase (Optional):" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtSrtPassphrase" Height="28" Margin="0,0,0,8" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2" TextChanged="SrtInput_TextChanged"/>

                    <TextBlock Text="SRT URL:" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtSrtUrl" Text="srt://127.0.0.1:9000?mode=caller&amp;latency=200000" Height="28" Margin="0,0,0,12" Background="{DynamicResource TextBoxBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="4,2"/>

                    <Button Name="BtnSrt" Content="START SRT" Height="40" Background="#0066cc" Foreground="{DynamicResource TextPrimary}" Click="BtnSrt_Click" FontWeight="Black" Cursor="Hand"/>
                    
                    <TextBlock Name="TxtStatus" Foreground="#00e676" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</Window>


