<Window x:Class="DecklinkSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DecklinkSwitcher"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="600"
        Title="DeckLink Switcher" Height="780" Width="1280" Background="#0f0f13" FontFamily="Segoe UI">
    
    <Window.Resources>
        <DataTemplate x:Key="InputTileTemplate">
            <Border Style="{DynamicResource MixerPanel}">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioL, Mode=OneWay}" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="#252530"/>
                        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="2" Background="Black">
                            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Height="100" Width="158" Cursor="Hand">
                                <Image.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectInputCmd}" />
                                </Image.InputBindings>
                            </Image>
                        </Border>
                        <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioR, Mode=OneWay}" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="#252530"/>
                        <Slider Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="{Binding AudioLevel, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1"/>
                    </StackPanel>
                    <Button Content="{Binding DisplayName}" Command="{Binding SelectInputCmd}" FontSize="14" FontWeight="SemiBold" Height="36" Background="{Binding BgColor}" Foreground="White" Cursor="Hand"/>
                    <ComboBox FontSize="12" Height="26" Margin="0,8,0,0" SelectedIndex="{Binding AudioStateIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="AFV"/>
                        <ComboBoxItem Content="ON"/>
                        <ComboBoxItem Content="OFF"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#555" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00e676"/>
                                <Setter TargetName="BtnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00e676" BlurRadius="20" ShadowDepth="0" Opacity="1.0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#00e676"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#ffffff"/>
                                <Setter TargetName="BtnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00e676" BlurRadius="30" ShadowDepth="0" Opacity="1.0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="MixerPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#252530" Offset="0.0" />
                        <GradientStop Color="#181820" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3a3a45"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1e1e24"/>
            <Setter Property="Foreground" Value="Black"/> <!-- Default text in standard combo box often requires black unless fully restyled -->
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT COLUMN: Previews and Switcher -->
        <Grid Grid.Column="0" Name="LeftPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Output Preview -->
                <RowDefinition Height="*"/> <!-- Inputs -->
            </Grid.RowDefinitions>
            
            <!-- Output Preview -->
            <Border Grid.Row="0" Style="{StaticResource MixerPanel}" Margin="0,0,0,25">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="PROGRAM OUTPUT" FontSize="22" FontWeight="Black" Foreground="#e0e0e0" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ProgressBar Name="AudioOutputL" Orientation="Vertical" Minimum="0" Maximum="100" Width="12" Height="270" Margin="0,0,15,0" Foreground="#00e676" Background="#252530"/>
                        <StackPanel Orientation="Vertical">
                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="4" Background="Black" Padding="2">
                                <Image Name="PreviewOutput" Stretch="Uniform" Height="270" Width="480"/>
                            </Border>
                            <CheckBox Name="ChkSystemAudioOut" Content="System Audio Out (Monitor)" Foreground="#aaa" Margin="0,10,0,0" HorizontalAlignment="Center" Checked="ChkSystemAudioOut_Checked" Unchecked="ChkSystemAudioOut_Unchecked"/>
                        </StackPanel>
                        <ProgressBar Name="AudioOutputR" Orientation="Vertical" Minimum="0" Maximum="100" Width="12" Height="270" Margin="15,0,0,0" Foreground="#00e676" Background="#252530"/>
                        
                        <StackPanel Orientation="Vertical" Margin="25,0,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="VOL" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Slider Name="SldPgmAudio" Orientation="Vertical" Height="250" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldPgmAudio_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SWITCHER PANEL -->
            <WrapPanel Grid.Row="1" Name="SwitcherPanel" IsEnabled="False" Orientation="Horizontal" HorizontalAlignment="Center">


            <!-- Special Sources -->
                <Border Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ProgressBar Name="AudioBarMediaL" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="#252530"/>
                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="2" Background="Black">
                                <Image Name="PreviewMedia" Stretch="Uniform" Height="100" Width="158" MouseDown="PreviewMedia_MouseDown" Cursor="Hand"/>
                            </Border>
                            <ProgressBar Name="AudioBarMediaR" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="#252530"/>
                            <Slider Name="SldMediaAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldMediaAudio_ValueChanged"/>
                        </StackPanel>
                        <Button Name="BtnMedia" Content="Local Video" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnMedia_Click" Background="#333344" Foreground="White" Margin="0,0,0,8" Cursor="Hand"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Name="BtnSelectMedia" Content="Select File" FontSize="11" Height="24" Width="65" Click="BtnSelectMedia_Click" Background="#444455" Foreground="White" Margin="0,0,4,0"/>
                            <Button Name="BtnCueMedia" Content="Cue" FontSize="11" Height="24" Width="35" Click="BtnCueMedia_Click" Background="#444455" Foreground="White" Margin="0,0,4,0"/>
                            <Button Name="BtnPauseMedia" Content="Pause" FontSize="11" Height="24" Width="45" Click="BtnPauseMedia_Click" Background="#444455" Foreground="White" Margin="0,0,4,0"/>
                            <Button Name="BtnResumeMedia" Content="Resume" FontSize="11" Height="24" Width="55" Click="BtnResumeMedia_Click" Background="#444455" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <CheckBox Name="ChkLoopMedia" Content="Loop" VerticalAlignment="Center" Foreground="#aaa" Margin="0,0,10,0"/>
                            <Slider Name="SldMediaSeek" Width="140" Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.01" 
                                    Thumb.DragStarted="SldMediaSeek_DragStarted" Thumb.DragCompleted="SldMediaSeek_DragCompleted" ValueChanged="SldMediaSeek_ValueChanged"/>
                        </StackPanel>
                        <ComboBox Name="CmbAudioStateMedia" FontSize="12" Height="26" SelectionChanged="CmbAudioState_SelectionChanged">
                            <ComboBoxItem Content="AFV"/>
                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ProgressBar Name="AudioBarCBL" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="0,0,8,0" Foreground="#00e676" Background="#252530"/>
                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="2" Background="Black">
                                <Image Name="PreviewColorBars" Stretch="Uniform" Height="100" Width="158" MouseDown="PreviewColorBars_MouseDown" Cursor="Hand"/>
                            </Border>
                            <ProgressBar Name="AudioBarCBR" Orientation="Vertical" Minimum="0" Maximum="100" Width="6" Height="100" Margin="8,0,8,0" Foreground="#00e676" Background="#252530"/>
                            <Slider Name="SldColorBarsAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldColorBarsAudio_ValueChanged"/>
                        </StackPanel>
                        <Button Name="BtnColorBars" Content="Color Bars" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnColorBars_Click" Background="#333344" Foreground="White" Cursor="Hand"/>
                        <ComboBox Name="CmbAudioStateColorBars" FontSize="12" Height="26" Margin="0,8,0,0" SelectionChanged="CmbAudioState_SelectionChanged">
                            <ComboBoxItem Content="AFV"/>
                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                
                <Border Style="{StaticResource MixerPanel}">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="2" Background="Black">
                                <Image Name="PreviewMatte" Stretch="Uniform" Height="100" Width="158" MouseDown="PreviewMatte_MouseDown" Cursor="Hand"/>
                            </Border>
                        </StackPanel>
                        <Button Name="BtnMatte" Content="Matte Color" FontSize="14" FontWeight="SemiBold" Height="36" Click="BtnMatte_Click" Background="#333344" Foreground="White" Margin="0,0,0,8" Cursor="Hand"/>
                        <ComboBox Name="CmbMatteColor" FontSize="12" Height="26" SelectedIndex="4" SelectionChanged="CmbMatteColor_SelectionChanged">
                            <ComboBoxItem Content="Black"/>
                            <ComboBoxItem Content="White"/>
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Yellow"/>
                            <ComboBoxItem Content="Cyan"/>
                            <ComboBoxItem Content="Magenta"/>
                        </ComboBox>
                    </StackPanel>
                </Border>


            </WrapPanel>
        </Grid>

        <!-- SETTINGS PANEL -->
        <Border Grid.Column="1" Style="{StaticResource MixerPanel}" Margin="25,0,0,0">
            <StackPanel>
                <TextBlock Text="SETTINGS" FontSize="16" Foreground="#e0e0e0" Margin="0,0,0,20" FontWeight="Black"/>
                
                <TextBlock Text="Output Device:" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
                <ComboBox Name="CmbOutput" Height="28" Margin="0,0,0,20" DisplayMemberPath="DisplayName"/>
                
                <ItemsControl Name="InputSelectorsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Label}" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableDevices}" 
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" 
                                          DisplayMemberPath="DisplayName" Height="28"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <Button Name="BtnApplySettings" Content="Apply Settings &amp; Start" Height="36" Background="#0066cc" Foreground="White" FontWeight="Bold" Click="BtnApplySettings_Click" Cursor="Hand" Margin="0,10,0,0"/>
                
                <Rectangle Height="1" Fill="#2a2a35" Margin="0,25,0,20"/>
                
                <TextBlock Text="YOUTUBE STREAMING" FontSize="14" Foreground="#e0e0e0" Margin="0,0,0,15" FontWeight="Black"/>
                <TextBlock Text="Stream Key:" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Name="TxtStreamKey" Margin="0,0,0,15" Height="28" Background="#1a1a20" Foreground="White" BorderBrush="#333" Padding="4,2"/>
                <Button Name="BtnStream" Content="START STREAM" Height="40" Background="#d32f2f" Foreground="White" Click="BtnStream_Click" FontWeight="Black" Cursor="Hand"/>
                
                <TextBlock Name="TxtStatus" Foreground="#00e676" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
