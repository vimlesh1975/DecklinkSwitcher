<Window x:Class="DecklinkSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DecklinkSwitcher"
        mc:Ignorable="d"
        Title="DeckLink Switcher" Height="700" Width="1200" Background="#1e1e1e">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT COLUMN: Previews and Switcher -->
        <Grid Grid.Column="0" Name="LeftPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Output Preview -->
                <RowDefinition Height="*"/> <!-- Inputs -->
            </Grid.RowDefinitions>
            
            <!-- Output Preview -->
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="PROGRAM OUTPUT" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar Name="AudioOutputL" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="250" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="PreviewOutput" Stretch="Uniform" Height="250" Width="444"/>
                    <ProgressBar Name="AudioOutputR" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="250" Margin="5,0,0,0" Foreground="#00ff00" Background="#333333"/>
                    
                    <StackPanel Orientation="Vertical" Margin="15,0,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="VOL" Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <Slider Name="SldPgmAudio" Orientation="Vertical" Height="230" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldPgmAudio_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- SWITCHER PANEL -->
            <Grid Grid.Row="1" Name="SwitcherPanel" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- Input 1 -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ProgressBar Name="AudioBar1L" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="Preview1" Stretch="Uniform" Height="100" Width="177" MouseDown="Preview1_MouseDown"/>
                    <ProgressBar Name="AudioBar1R" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="5,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Slider Name="SldInput1Audio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldInput1Audio_ValueChanged"/>
                </StackPanel>
                <Button Name="BtnInput1" Content="Input 1" FontSize="16" Height="40" Click="BtnInput1_Click" Background="#2d2d30" Foreground="White"/>
            </StackPanel>

            <!-- Input 2 -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ProgressBar Name="AudioBar2L" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="Preview2" Stretch="Uniform" Height="100" Width="177" MouseDown="Preview2_MouseDown"/>
                    <ProgressBar Name="AudioBar2R" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="5,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Slider Name="SldInput2Audio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldInput2Audio_ValueChanged"/>
                </StackPanel>
                <Button Name="BtnInput2" Content="Input 2" FontSize="16" Height="40" Click="BtnInput2_Click" Background="#2d2d30" Foreground="White"/>
            </StackPanel>

            <!-- Input 3 -->
            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ProgressBar Name="AudioBar3L" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="Preview3" Stretch="Uniform" Height="100" Width="177" MouseDown="Preview3_MouseDown"/>
                    <ProgressBar Name="AudioBar3R" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="5,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Slider Name="SldInput3Audio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldInput3Audio_ValueChanged"/>
                </StackPanel>
                <Button Name="BtnInput3" Content="Input 3" FontSize="16" Height="40" Click="BtnInput3_Click" Background="#2d2d30" Foreground="White"/>
            </StackPanel>

            <!-- Input 4 -->
            <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ProgressBar Name="AudioBar4L" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="Preview4" Stretch="Uniform" Height="100" Width="177" MouseDown="Preview4_MouseDown"/>
                    <ProgressBar Name="AudioBar4R" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="5,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Slider Name="SldInput4Audio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldInput4Audio_ValueChanged"/>
                </StackPanel>
                <Button Name="BtnInput4" Content="Input 4" FontSize="16" Height="40" Click="BtnInput4_Click" Background="#2d2d30" Foreground="White"/>
            </StackPanel>

            <!-- Special Sources -->
            <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ProgressBar Name="AudioBarMediaL" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="PreviewMedia" Stretch="Uniform" Height="100" Width="177" MouseDown="PreviewMedia_MouseDown"/>
                    <ProgressBar Name="AudioBarMediaR" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="5,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Slider Name="SldMediaAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldMediaAudio_ValueChanged"/>
                </StackPanel>
                <Button Name="BtnMedia" Content="Local Video" FontSize="16" Height="40" Click="BtnMedia_Click" Background="#2d2d30" Foreground="White" Margin="0,0,0,5"/>
                <Button Name="BtnSelectMedia" Content="Select File..." FontSize="14" Height="30" Click="BtnSelectMedia_Click" Background="#333333" Foreground="LightGray"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ProgressBar Name="AudioBarCBL" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="0,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Image Name="PreviewColorBars" Stretch="Uniform" Height="100" Width="177" MouseDown="PreviewColorBars_MouseDown"/>
                    <ProgressBar Name="AudioBarCBR" Orientation="Vertical" Minimum="0" Maximum="100" Width="10" Height="100" Margin="5,0,5,0" Foreground="#00ff00" Background="#333333"/>
                    <Slider Name="SldColorBarsAudio" Orientation="Vertical" Height="100" Minimum="0" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldColorBarsAudio_ValueChanged"/>
                </StackPanel>
                <Button Name="BtnColorBars" Content="Color Bars + Tone" FontSize="16" Height="40" Click="BtnColorBars_Click" Background="#2d2d30" Foreground="White"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Vertical" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Image Name="PreviewMatte" Stretch="Uniform" Height="100" Width="177" MouseDown="PreviewMatte_MouseDown"/>
                </StackPanel>
                <Button Name="BtnMatte" Content="Matte Color" FontSize="16" Height="40" Click="BtnMatte_Click" Background="#2d2d30" Foreground="White" Margin="0,0,0,5"/>
                <ComboBox Name="CmbMatteColor" FontSize="14" Height="30" SelectedIndex="4" SelectionChanged="CmbMatteColor_SelectionChanged">
                    <ComboBoxItem Content="Black"/>
                    <ComboBoxItem Content="White"/>
                    <ComboBoxItem Content="Red"/>
                    <ComboBoxItem Content="Green"/>
                    <ComboBoxItem Content="Blue"/>
                    <ComboBoxItem Content="Yellow"/>
                    <ComboBoxItem Content="Cyan"/>
                    <ComboBoxItem Content="Magenta"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        </Grid>

        <!-- SETTINGS PANEL -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Settings" FontSize="20" Foreground="White" Margin="0,0,0,20" FontWeight="Bold"/>
            
            <TextBlock Text="Output Device:" Foreground="LightGray"/>
            <ComboBox Name="CmbOutput" Margin="0,5,0,15" DisplayMemberPath="DisplayName"/>
            
            <TextBlock Text="Button 1 Input:" Foreground="LightGray"/>
            <ComboBox Name="CmbInput1" Margin="0,5,0,15" DisplayMemberPath="DisplayName"/>
            
            <TextBlock Text="Button 2 Input:" Foreground="LightGray"/>
            <ComboBox Name="CmbInput2" Margin="0,5,0,15" DisplayMemberPath="DisplayName"/>
            
            <TextBlock Text="Button 3 Input:" Foreground="LightGray"/>
            <ComboBox Name="CmbInput3" Margin="0,5,0,15" DisplayMemberPath="DisplayName"/>
            
            <TextBlock Text="Button 4 Input:" Foreground="LightGray"/>
            <ComboBox Name="CmbInput4" Margin="0,5,0,20" DisplayMemberPath="DisplayName"/>
            
            <Button Name="BtnApplySettings" Content="Apply Settings &amp; Start" Height="40" Background="#007acc" Foreground="White" Click="BtnApplySettings_Click"/>
            <TextBlock Name="TxtStatus" Foreground="LightGreen" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
