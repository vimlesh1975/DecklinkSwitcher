                    <SolidColorBrush x:Key="OutputSectionBg" Color="#15161c"/>
                    <SolidColorBrush x:Key="PgmSectionBorder" Color="#2e6da4"/>
                    <SolidColorBrush x:Key="SettingsSectionBorder" Color="#6c757d"/>
                    <SolidColorBrush x:Key="OutputSectionBorder" Color="#7c5cdb"/>
                    <SolidColorBrush x:Key="SourcesSectionBg" Color="#151c1a"/>
                    <SolidColorBrush x:Key="SourcesSectionBorder" Color="#2e8b6d"/>
                    <SolidColorBrush x:Key="OverlayCardNdiBg" Color="#232436"/>
                    <SolidColorBrush x:Key="OverlayCardHtmlBg" Color="#1e2d33"/>
                    <SolidColorBrush x:Key="OverlayCardPgmBg" Color="#1f2633"/>
                    <SolidColorBrush x:Key="OverlayCardLogoBg" Color="#2a2622"/>
